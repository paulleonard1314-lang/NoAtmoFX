<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>NoAtmoFX</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Version>1.0.0</Version>
    <OutputPath>bin/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoStdLib>true</NoStdLib>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoWarn>CS0436;CS0649</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Game folder. Override with: dotnet build -p:NO="D:\Games\Nuclear Option" -->
    <NO Condition="'$(NO)'==''">C:\Program Files (x86)\Steam\steamapps\common\Nuclear Option</NO>
    <M>$(NO)/NuclearOption_Data/Managed</M>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Plugin.cs" />
    <Compile Include="WetGlass.cs" />
    <Compile Include="Atmos.cs" />
    <Compile Include="Nuke.cs" />
    <Reference Include="mscorlib"><HintPath>$(M)/mscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="netstandard"><HintPath>$(M)/netstandard.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System"><HintPath>$(M)/System.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Core"><HintPath>$(M)/System.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(NO)/BepInEx/core/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(NO)/BepInEx/core/BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(M)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(M)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AssetBundleModule"><HintPath>$(M)/UnityEngine.AssetBundleModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(M)/UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(M)/UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.RenderPipelines.Core.Runtime"><HintPath>$(M)/Unity.RenderPipelines.Core.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.RenderPipelines.Universal.Runtime"><HintPath>$(M)/Unity.RenderPipelines.Universal.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(M)/UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(M)/UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(M)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mirage"><HintPath>$(M)/Mirage.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
